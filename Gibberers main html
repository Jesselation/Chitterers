  sampleShuffle:()=>{const pool=ALL.filter(c=>(S.exp||!c.x)&&c.id!==ui.modal.cid);ui.modal.cid=pool[Math.floor(Math.random()*pool.length)].id;renderModal()},
  sampleReset:()=>{ui.modal.cid=SAMPLE;renderModal()},
  fullRules:()=>{ui.modal=null;S.tab='rules';save();render();window.scrollTo(0,0)},
  start:()=>{keepSetup();for(let i=0;i<S.n;i++)S.players[i]=S.players[i]||`Player ${i+1}`;
    for(const e of [1,2,3,4,5])S.decks[e]=shuffle(ALL.filter(c=>c.era===e&&(S.exp||!c.x)).map(c=>c.id));
    S.phase='gen0';S.mentor=0;ui.err='';save();render()},
  dice:d=>{$(d.v).value=genPron()},
  toggleAnc:()=>{const p=val('pron'),m=val('mean');ui.anc=!ui.anc;render();$('pron').value=p;$('mean').value=m},
  addBasic:()=>{const p=val('pron'),m=val('mean');if(!m){ui.err='Choose a meaning.';const pp=p;render();$('pron').value=pp;return}
    const e=checkPron(p,[m]);if(e){ui.err=e;render();$('pron').value=p;$('mean').value=m;return}
    addWord(p,m,'basic');ui.err='';save();render();$('pron')&&$('pron').focus()},
  delWord:d=>{S.words=S.words.filter(w=>w.id!==+d.v);save();render()},
  toRitual:()=>{S.phase='ritual';save();render()},
  autofill:()=>{const left=basicN()-S.words.filter(w=>w.kind==='basic').length;
    ui.modal={t:'confirm',title:`Autofill ${left} word${left===1?'':'s'}?`,body:'Random sounds are paired with common basic meanings, always including Yes, No, I and Know. Words you’ve already made stay as they are, and you can remove any autofilled word afterwards.',yes:'Autofill',then:autofillBasic};renderModal()},
  beginDev:()=>startRound(),
  mentorView:()=>{ui.mentorView=S.round.preDone?'card':'pre';ui.err='';render()},
  preDone:()=>{const r=S.round,kp=val('kp'),sp=val('sp');let e=kp?checkPron(kp,[]):'';if(!e&&sp)e=checkPron(sp,[]);if(!e&&kp&&sp&&norm(kp)===norm(sp))e='Use two different sounds.';
    if(e){ui.err=e;render();$('kp').value=kp;$('sp').value=sp;return}
    r.pre={kp,sp,sm:''};r.preDone=true;ui.mentorView='card';ui.err='';save();render()},
  preSkip:()=>{S.round.preDone=true;ui.mentorView='card';ui.err='';save();render()},
  hideCard:()=>{keepPre();ui.mentorView=false;save();render()},
  redraw:()=>{keepPre();const r=S.round;r.cards.push(S.decks[r.gen].shift());r.redrawn=true;save();render()},
  pick:d=>{keepPre();S.round.pick={card:+d.c,slot:+d.s};ui.err='';save();render()},
  lock:()=>{const r=S.round,p=val('kp'),sp=val('sp'),sm=val('sm'),item=ALL[r.pick.card].items[r.pick.slot];
    let e=checkPron(p,[item]);
    if(!e&&sp){e=checkPron(sp,sm?[sm]:[]);if(!e&&norm(sp)===norm(p))e='The supporting word needs a different sound from the new word.'}
    if(e){ui.err=e;render();$('kp').value=p;$('sp').value=sp;$('sm').value=sm;return}
    r.pronId=addWord(p,null,'knowledge',{pending:true}).id;
    if(sp){const sw=addWord(sp,null,'support');if(sm)sw.secret=sm;r.supportId=sw.id}
    r.cards.filter(c=>c!==r.pick.card).forEach(c=>S.decks[r.gen].push(c));
    S.board=Math.min(5,S.board+ADD[r.gen]);r.startAt=Date.now();
    S.phase='enlighten';ui.err='';ui.mentorView=false;save();render();window.scrollTo(0,0)},
  answer:()=>{ui.modal={t:'answer'};renderModal()},
  judge:d=>{const g=val('guess');S.board--;ui.modal=null;
    if(d.v==='1')return goApply('success');
    S.round.guesses.push(g||'(unrecorded)');save();
    if(S.board<1)return goApply('failure');render()},
  hint:d=>{ui.err='';if(d.v==='ancestor')ui.modal={t:'ancestor'};if(d.v==='telepathy')ui.modal={t:'telepathy'};if(d.v==='inspiration')ui.modal={t:'newword',k:'inspiration'};renderModal()},
  ancCard:d=>{if(!S.round.hints.ancestor){S.round.hints.ancestor=true;S.board-=1;save()}ui.modal={t:'ancestor',card:+d.v};render()},
  ancPoint:(d,el,e)=>{const r=el.getBoundingClientRect();ui.modal.pt=[((e.clientX-r.left)/r.width*100).toFixed(1),((e.clientY-r.top)/r.height*100).toFixed(1)];renderModal()},
  ancBack:()=>{ui.modal={t:'ancestor',card:null};renderModal()},
  ancStep:d=>{ui.modal.card=cyc(ui.modal.card,+d.v);ui.modal.pt=null;renderModal()},
  fsOpen:d=>{ui.fs={i:+d.v,mode:'browse'};ui.rot=0;ui.manualRot=false;startTilt();renderFS()},
  fsAnc:()=>{ui.fs={mode:'anc'};ui.rot=0;ui.manualRot=false;startTilt();renderFS()},
  fsRotate:()=>{const o=[0,90,-90];ui.rot=o[(o.indexOf(ui.rot||0)+1)%3];ui.manualRot=true;renderFS()},
  fsClose:()=>{const anc=ui.fs&&ui.fs.mode==='anc';ui.fs=null;ui.rot=0;ui.manualRot=false;renderFS();if(anc)renderModal()},
  fsStep:d=>{if(ui.fs.mode==='anc'){ui.modal.card=cyc(ui.modal.card,+d.v);ui.modal.pt=null}else ui.fs.i=cyc(ui.fs.i,+d.v);renderFS()},
  fsPoint:(d,el,e)=>{const r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width,y=(e.clientY-r.top)/r.height,rot=ui.rot||0;let u=x,v=y;if(rot===90){u=y;v=1-x}else if(rot===-90){u=1-y;v=x}ui.modal.pt=[(u*100).toFixed(1),(v*100).toFixed(1)];renderFS()},
  doTele:()=>{const m=wordById(S.round.supportId).secret||val('tm');if(!m){ui.err='Write the meaning.';renderModal();return}
    wordById(S.round.supportId).meaning=m;S.round.hints.telepathy=true;S.board-=2;ui.modal=null;ui.err='';save();endIfEmpty()},
  support:()=>{ui.err='';ui.modal={t:'newword',k:'support'};renderModal()},
  saveNew:()=>{const M=ui.modal,p=val('nwp'),m=val('nwm');
    if(M.k!=='support'&&!m){ui.err='Write a meaning.';renderModal();$('nwp').value=p;return}
    const ex=M.k==='support'?[ALL[S.round.pick.card].items[S.round.pick.slot]]:[m];
    const e=checkPron(p,M.k==='support'?[]:ex);if(e){ui.err=e;renderModal();$('nwp').value=p;if($('nwm'))$('nwm').value=m;return}
    const w=addWord(p,M.k==='support'?null:m,M.k);if(M.k==='support'&&m)w.secret=m;
    if(M.k==='support')S.round.supportId=w.id;
    if(M.k==='inspiration'){S.round.hints.inspiration=true;S.board-=3;S.round.inspId=w.id}
    if(M.k==='bonus')S.tok[M.bt][1]+=M.bt==='W'?1:2;
    ui.modal=null;ui.err='';save();endIfEmpty()},
  undoHint:d=>{const[n,,b]=HINT_INFO[d.v];ui.modal={t:'confirm',title:`Undo ${n}?`,body:b,yes:'Undo hint',then:()=>undoHint(d.v)};renderModal()},
  peek:()=>{ui.peek=!ui.peek;render()},
  giveup:()=>{ui.modal={t:'confirm',title:'End this round as a failure?',body:'No development tokens are gained, but the word still joins the dictionary.',yes:'End round',then:()=>goApply('failure')};renderModal()},
  award:d=>{const r=S.round;if(r.awarded)return;const i=r.award.indexOf(d.v);i>=0?r.award.splice(i,1):r.award.push(d.v);save();render()},
  take:()=>{const r=S.round;r.award.forEach(t=>S.tok[t][0]++);r.awarded=true;save();render()},
  supMean:()=>{const m=val('supm');if(m){wordById(S.round.supportId).meaning=m;save();render()}},
  bonus:d=>{ui.err='';ui.modal={t:'newword',k:'bonus',bt:d.v};renderModal()},
  next:()=>{S.mentor=(S.mentor+1)%S.n;startRound();window.scrollTo(0,0)},
  toTally:()=>{S.phase='tally';save();render();window.scrollTo(0,0)},
  endNow:()=>{ui.modal={t:'confirm',title:'End the game now?',body:'You’ll go straight to the final screen with what you’ve achieved so far. Any round in progress is dropped, and its untaught word is removed. This can’t be undone.',yes:'End game',then:()=>{const r=S.round;
    if(r&&(S.phase==='prepare'||S.phase==='enlighten')){if(r.pronId!=null)S.words=S.words.filter(w=>w.id!==r.pronId);if(r.inspId!=null&&S.phase==='enlighten'){}}
    if(S.phase==='apply'&&r&&r.result==='success'&&!r.awarded){r.award.forEach(t=>S.tok[t][0]++);r.awarded=true}
    S.endedEarly=true;S.phase='tally';save();window.scrollTo(0,0)}};renderModal()},
  newGame:()=>{ui.modal={t:'confirm',title:'Start a new civilization?',body:'This erases the current game and its dictionary from this device.',yes:'Start over',then:()=>{const t=S.timer,x=S.exp,md=S.mode,nl=S.nameLater,cu=S.custom?JSON.parse(JSON.stringify(S.custom)):null;S=fresh();S.timer=t;S.exp=x;S.mode=md;S.nameLater=nl;if(cu)S.custom=cu;ui.phrase=[];ui.phSel=null;ui.modal=null;save();render()}};renderModal()},
  confirmYes:()=>{const f=ui.modal.then;ui.modal=null;f();render()},
  close:()=>{ui.modal=null;ui.err='';endIfEmpty()},
  overlay:(d,el,e)=>{if(e.target===el&&!(ui.modal&&ui.modal.t==='answer')){ui.modal=null;ui.err='';render()}}
};
function keepSetup(){if(S.phase!=='setup')return;if($('civ'))S.civ=val('civ');for(let i=0;i<S.n;i++)if($('p'+i))S.players[i]=val('p'+i);ui.err=''}
let swipe=null,lastSwipe=0;
document.addEventListener('touchstart',e=>{const t=e.target.closest&&e.target.closest('[data-swipe]');swipe=t&&e.touches.length===1?{x:e.touches[0].clientX,y:e.touches[0].clientY,k:t.dataset.swipe}:null},{passive:true});
document.addEventListener('touchend',e=>{if(!swipe)return;const t=e.changedTouches[0],k=swipe.k;let dx=t.clientX-swipe.x,dy=t.clientY-swipe.y;swipe=null;
  if(k==='fs'&&ui.rot)[dx,dy]=ui.rot===90?[dy,-dx]:[-dy,dx];
  if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.5){lastSwipe=Date.now();const v=dx<0?1:-1;if(k==='fs')A.fsStep({v});else if(k==='sample'&&ui.modal&&ui.modal.t==='sample')A.sampleStep({v});else if(ui.modal&&ui.modal.card!=null)A.ancStep({v})}},{passive:true});
document.addEventListener('keydown',e=>{if(ui.phShow&&e.key==='Escape'){A.phHide();e.stopImmediatePropagation();e.preventDefault()}},true);
document.addEventListener('keydown',e=>{if(!ui.fs)return;if(e.key==='Escape'){A.fsClose();e.stopImmediatePropagation();e.preventDefault()}else if(e.key==='ArrowLeft'||e.key==='ArrowRight'){A.fsStep({v:e.key==='ArrowLeft'?-1:1});e.preventDefault()}},true);
/* Drag to reorder words in the phrase presenter */
let phDrag=null;
document.addEventListener('pointerdown',e=>{const t=e.target.closest&&e.target.closest('[data-phi]');phDrag=t?{i:+t.dataset.phi,x:e.clientX,y:e.clientY,on:false}:null});
document.addEventListener('pointermove',e=>{if(!phDrag)return;
  if(!phDrag.on){if(Math.hypot(e.clientX-phDrag.x,e.clientY-phDrag.y)<8)return;phDrag.on=true;ui.phSel=phDrag.i;renderPhrase();updPh()}
  e.preventDefault();
  const el=document.elementFromPoint(e.clientX,e.clientY),t=el&&el.closest('[data-phi]');
  if(t){const j=+t.dataset.phi,i=phDrag.i;if(j!==i){const p=ui.phrase,[w]=p.splice(i,1);p.splice(j,0,w);phDrag.i=j;ui.phSel=j;renderPhrase();updPh()}}},{passive:false});
const phEnd=()=>{if(phDrag&&phDrag.on)lastSwipe=Date.now();phDrag=null};
document.addEventListener('pointerup',phEnd);document.addEventListener('pointercancel',phEnd);
document.addEventListener('click',e=>{if(Date.now()-lastSwipe<400)return;const el=e.target.closest('[data-a]');if(!el)return;if(el.dataset.a==='overlay'&&e.target!==el)return;const f=A[el.dataset.a];if(f)f(el.dataset,el,e)});
document.addEventListener('input',e=>{const k=e.target.dataset&&e.target.dataset.input;
  if(k==='pq'){ui.pq=e.target.value;$('phpick').innerHTML=pickHTML()}
  if(k==='dq'){ui.q=e.target.value;const tmp=document.createElement('div');tmp.innerHTML=dictView();$('dlist').innerHTML=tmp.querySelector('#dlist').innerHTML}
  if(k==='great'){S.great=e.target.value;save()}});
document.addEventListener('keydown',e=>{if(e.key==='Enter'&&e.target.tagName==='INPUT'){const map={pron:'addBasic',mean:'addBasic',kp:'lock',sp:'lock',sm:'lock',nwp:'saveNew',nwm:'saveNew',tm:'doTele',civn:'nameCiv',supm:'supMean'};const a=map[e.target.id];if(a){e.preventDefault();A[a]({})}}
  if(e.key==='Escape'&&ui.modal){ui.modal=null;render()}});

/* ---------- Timer ---------- */
let tickH=null;
function tick(){clearInterval(tickH);if(S.phase!=='enlighten'||!S.timer||S.tab!=='play')return;
  const upd=()=>{const el=$('timer');if(!el)return;const left=Math.max(0,S.timer*60-Math.floor((Date.now()-S.round.startAt)/1000));
    el.textContent=left?`${Math.floor(left/60)}:${String(left%60).padStart(2,'0')}`:'Time’s up. End the round as a failure when ready.';el.classList.toggle('out',!left)};
  upd();tickH=setInterval(upd,1000)}

render();
</script>
</body>
</html>
