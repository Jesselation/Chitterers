  const req=['Yes','No','I','Know'].map(r=>({r,ok:basics.some(w=>norm(w.meaning)===norm(r))}));
  const done=basics.length>=basicN()&&req.every(x=>x.ok);
  const form=basics.length<basicN()?`<div class="panel">
    <p><strong>Word ${basics.length+1} of ${basicN()}.</strong> ${esc(who)} creates this one; everyone can discuss.</p>
    <label for="pron">Pronunciation</label>
    <div class="row"><input type="text" id="pron" class="hand" style="font-size:1.4rem" autocomplete="off"><button class="g" data-a="dice" data-v="pron" aria-label="Generate a random pronunciation">🎲 Random</button></div>
    <label for="mean">Meaning</label>
    <div class="row"><input type="text" id="mean" autocomplete="off" placeholder="Type it, or pick a drawing"><button class="g" data-a="toggleAnc">${ui.anc?'Hide drawings':'Drawings'}</button></div>
    ${ui.anc?`<p class="small muted" style="margin:8px 0 0">Look across the ancestor drawings for meanings your language needs, then type one in. Tap a drawing to view it full screen and swipe between them.</p><div class="cave-list">${CAVE.map((s,i)=>`<button data-a="fsOpen" data-v="${i}" aria-label="View ancestor drawing ${i+1} full screen"><img src="${s}" alt="Ancestor drawing ${i+1}"></button>`).join('')}</div>`:''}
    ${errHTML()}
    <button class="b wide" data-a="addBasic">Add word</button></div>`:'';
  return`<h2>Generation 0: basic words</h2>${spot('mo','Mo, a round teal creature, winking','sm')}
  <p class="muted">Create ${basicN()} words, one each in clockwise order. Use one kind of sound throughout, never reuse a sound, and never pick a sound that resembles the meaning. One to four syllables works best.</p>
  <div class="check">Must include: ${req.map(x=>`<span class="${x.ok?'ok':''}">${x.ok?'✓':'○'} ${x.r}</span>`).join('')}</div>
  ${basics.length<basicN()?`<button class="g wide" data-a="autofill">Autofill ${basics.length?'the remaining '+(basicN()-basics.length):'all '+basicN()} words (testing or quick start)</button>`:''}
  ${form}
  ${basics.length?`<h3>Your words so far</h3><div class="grid">${basics.map(w=>`<div>${noteHTML(w)}<button class="g small" style="margin-top:4px;width:100%" data-a="delWord" data-v="${w.id}">Remove</button></div>`).join('')}</div>`:''}
  ${basics.length>=basicN()&&!done?`<p class="err">You have ${basicN()} words but are missing ${req.filter(x=>!x.ok).map(x=>x.r).join(', ')}. Remove a word and add the missing ones.</p>`:''}
  ${done?`<button class="b wide" data-a="toRitual">Finish basic words</button>`:''}`;
}
