  `<h2>What Students see</h2><p class="small">Only the new sound. The Mentor explains using words already in the dictionary, plus gestures in Generations 1 and 2, and can add a supporting word.</p>
  <div class="grid" style="grid-template-columns:1fr 1fr">${noteHTML({pron:'Bulomi',meaning:null,kind:'knowledge'})}${noteHTML({pron:'Tekka',meaning:null,kind:'support'})}</div>
  <p class="small" style="margin:12px 0 6px">Words the group made earlier:</p>
  <div class="grid" style="grid-template-columns:repeat(3,1fr)">${[['Aru','water'],['Pemi','animal'],['Sotu','move']].map(([p,m])=>noteHTML({pron:p,meaning:m,kind:'basic'})).join('')}</div>
  <p class="small" style="margin:12px 0 0">The Mentor says “<span class="hand" style="font-size:1.25rem">Bulomi… Pemi, Aru, Sotu!</span>” and mimes swimming.</p>
  <div class="tokens" role="img" aria-label="5 Enlighten tokens">${Array.from({length:5},()=>`<span class="tok on">${TOK}</span>`).join('')}</div>
  <p class="small muted" style="text-align:center;margin:0">Students share 5 tokens. Each answer or hint spends some.</p>`,
  `<h2>The reveal</h2><p class="small">A Student says “I know” in the new language, spends a token, and answers in the old language: “Fish!” That counts.</p>
  ${noteHTML({pron:'Bulomi',meaning:ex,kind:'knowledge'},true)}
  <p class="small" style="text-align:center">Bulomi joins the dictionary for good${types.length?`, and the civilization gains a <strong style="color:var(${T[types[0]].v})">${T[types[0]].n}</strong> token`:''}. Then the next player becomes Mentor.</p>`];
  return`<div data-swipe="sample">${steps[M.step]}</div>
  <div class="cave-nav" style="margin-top:12px"><button class="g" data-a="sampleStep" data-v="-1" ${M.step===0?'disabled':''} aria-label="Previous step">‹ Back</button><span class="small">${M.step+1} / 3</span>${M.step<2?'<button class="b" data-a="sampleStep" data-v="1" aria-label="Next step">Next ›</button>':'<button class="b" data-a="close">Done</button>'}</div>`}

/* ---------- Modals ---------- */
function renderModal(){
  const M=ui.modal,el=$('modal');
  if(!M){el.innerHTML='';return}
  let h='';
  if(M.t==='answer')h=`<h2>“I know!”</h2><p>Student: pass a token to the Mentor and say your answer in the old language.</p>
    <label for="guess">Answer given (optional)</label><input type="text" id="guess" autocomplete="off">
    <p class="small muted" style="margin-top:8px">Mentor: does it match <strong>${esc(ALL[S.round.pick.card].items[S.round.pick.slot])}</strong> closely enough? (Students: don’t look.)</p>
    <div class="row"><button class="b" style="flex:1;background:var(--ok);border-color:var(--ok)" data-a="judge" data-v="1">Correct</button><button class="b" style="flex:1;background:var(--bad);border-color:var(--bad)" data-a="judge" data-v="0">Not right</button></div>
    <button class="g wide" data-a="close">Cancel</button>`;
  if(M.t==='ancestor')h=M.card==null?
    `<h2>Ancestor hint</h2><p>Mentor: choose a drawing. This spends 1 token.</p><div class="cave-grid">${CAVE.map((s,i)=>`<button data-a="ancCard" data-v="${i}"><img src="${s}" alt="">Drawing ${i+1}</button>`).join('')}</div><button class="g wide" data-a="close">Cancel</button>`:
    `<h2>Ancestor drawing ${M.card+1}</h2><p class="small muted">Mentor: tap the part you mean, or point at it on the screen. Swipe to change drawing.</p><div class="cave" data-a="ancPoint" data-swipe="anc"><img src="${CAVE[M.card]}" alt="Ancestor drawing ${M.card+1}">${M.pt?`<span class="pin" style="left:${M.pt[0]}%;top:${M.pt[1]}%"></span>`:''}</div><div class="cave-nav"><button class="g" data-a="ancStep" data-v="-1" aria-label="Previous drawing">‹ Prev</button><span class="small">${M.card+1} / ${CAVE.length}</span><button class="g" data-a="ancStep" data-v="1" aria-label="Next drawing">Next ›</button></div><button class="g wide" data-a="fsAnc">⛶ View full screen</button><button class="b wide" data-a="close">Done</button><button class="g wide" data-a="ancBack">Back to all drawings</button>`;
  if(M.t==='telepathy'){const s=wordById(S.round.supportId);h=`<h2>Telepathy</h2>${s.secret?`<p>Reveal the meaning of supporting word <span class="hand" style="font-size:1.4rem">${esc(s.pron)}</span>? The Mentor already set it privately. This spends 2 tokens.</p>`:`<p>Mentor: write the meaning of supporting word <span class="hand" style="font-size:1.4rem">${esc(s.pron)}</span>. This spends 2 tokens.</p><input type="text" id="tm" autocomplete="off">`}${errHTML()}<button class="b wide" data-a="doTele">Pay 2 tokens and reveal</button><button class="g wide" data-a="close">Cancel</button>`}
  if(M.t==='newword'){const lab=M.k==='bonus'?`Development bonus (${T[M.bt].n})`:M.k==='inspiration'?'Inspiration: add a new word (3 tokens)':'Supporting word';
    h=`<h2>${lab}</h2>${M.k==='bonus'?`<p class="small muted">Discuss the meaning together; ${esc(mentorName())} decides the sound.</p>`:''}
    <label for="nwp">Pronunciation</label><div class="row"><input type="text" id="nwp" class="hand" style="font-size:1.4rem" autocomplete="off"><button class="g" data-a="dice" data-v="nwp">🎲</button></div>
    <label for="nwm">${M.k==='support'?'Meaning (optional, stays hidden unless Students pay for Telepathy)':'Meaning'}</label><input type="text" id="nwm" autocomplete="off">
    ${errHTML()}<button class="b wide" data-a="saveNew">Add to dictionary</button><button class="g wide" data-a="close">Cancel</button>`}
  if(M.t==='sample')h=sampleHTML(M);
  if(M.t==='qref')h=`<h2>Quick reference</h2>${qrefHTML()}<button class="b wide" data-a="close">Back to the game</button><button class="g wide" data-a="fullRules">Open the full rules</button>`;
  if(M.t==='confirm')h=`<h2>${esc(M.title)}</h2><p>${esc(M.body)}</p><div class="row"><button class="b" style="flex:1" data-a="confirmYes">${esc(M.yes)}</button><button class="g" style="flex:1" data-a="close">Cancel</button></div>`;
  el.innerHTML=`<div class="overlay" data-a="overlay"><div class="sheet" role="dialog" aria-modal="true">${h}</div></div>`;
  const f=el.querySelector('input');if(f)f.focus();
}

