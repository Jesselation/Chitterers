  const rest=shuffle(AUTO_MEANINGS.filter(m=>!have.has(norm(m))&&!req.includes(m)));
  for(const m of req.concat(rest)){if(left<1)break;let p='',tries=0;do{p=genPron(['yes','no','i','know'].includes(norm(m))?2:engSyl(m)<=1);tries++}while(checkPron(p,[m])&&tries<60);if(checkPron(p,[m]))continue;addWord(p,m,'basic');left--}
  ui.err='';save();
}
function endIfEmpty(){render()}
const HINT_INFO={ancestor:['Ancestor',1,'Refunds 1 token.'],telepathy:['Telepathy',2,'Refunds 2 tokens and hides the supporting word’s meaning again.'],inspiration:['Inspiration',3,'Refunds 3 tokens and removes the word it added from the dictionary.']};
function undoHint(k){const r=S.round,c=HINT_INFO[k][1];if(!r||!r.hints[k])return;r.hints[k]=false;S.board=Math.min(5,S.board+c);
  if(k==='telepathy'){const sw=r.supportId&&wordById(r.supportId);if(sw){if(!sw.secret)sw.secret=sw.meaning;sw.meaning=null}}
  if(k==='inspiration'&&r.inspId!=null){S.words=S.words.filter(w=>w.id!==r.inspId);r.inspId=null}
  save()}

/* ---------- Sample card walkthrough (for teaching) ---------- */
