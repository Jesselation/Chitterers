function icons(list){return list.map(t=>`<span class="dot" style="background:var(${T[t].v})" title="${T[t].n}"></span>`).join('')}
function noteHTML(w,big){const m=w.meaning==null?'<div class="m q">?</div>':`<div class="m">${esc(w.meaning)}</div>`;const lab={support:'Supporting word',inspiration:'Inspiration word',bonus:'Bonus word'}[w.kind];const k=lab?`<div class="k">${lab}</div>`:'';return`<div class="note${big?' big':''}${w.kind==='support'?' sup':''}"><div class="p">${esc(w.pron)}</div>${m}${k}</div>`}
