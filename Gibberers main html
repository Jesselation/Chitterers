  phAddMore:()=>{ui.phShow=false;ui.phSel=null;renderPhrase();S.tab='phrase';save();render();window.scrollTo(0,0)},
  ynToggle:()=>{ui.yn=!ui.yn;updPh();if(ui.phShow)renderPhrase()},
