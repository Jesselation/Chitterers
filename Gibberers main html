<style>
:root{
  --bg:#E4EAEE;--surface:#F7F9FA;--ink:#1E2940;--muted:#56637C;--line:#BAC5D0;
  --note:#F2EBDA;--note-ink:#1F1A14;--note-q:#8A6A2E;
  --d:#3E8E5A;--c:#7B5CC4;--m:#C2413B;--s:#2F7CB8;--w:#B8820F;
  --ok:#2E7D4F;--bad:#B3392F;--btn:#1E2940;--btn-ink:#F7F9FA;
  color-scheme:light;box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#121826;--surface:#1C2436;--ink:#E6ECF4;--muted:#9AA6BC;--line:#2F3B54;
  --note:#E6DCC4;--note-ink:#1F1A14;--note-q:#7A5C24;
  --d:#5DB37C;--c:#A68BEA;--m:#E0675F;--s:#5BA4DD;--w:#E2B23C;
  --ok:#5DB37C;--bad:#E0675F;--btn:#E6ECF4;--btn-ink:#121826;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#121826;--surface:#1C2436;--ink:#E6ECF4;--muted:#9AA6BC;--line:#2F3B54;
  --note:#E6DCC4;--note-ink:#1F1A14;--note-q:#7A5C24;
  --d:#5DB37C;--c:#A68BEA;--m:#E0675F;--s:#5BA4DD;--w:#E2B23C;
  --ok:#5DB37C;--bad:#E0675F;--btn:#E6ECF4;--btn-ink:#121826;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:17px;line-height:1.5}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--surface)}
.hand{font-family:"Gaegu","Segoe Print","Comic Sans MS",cursive}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--surface);border-bottom:1px solid var(--line);padding:10px 16px 0}
.bar{max-width:720px;margin:0 auto}
.civ{display:flex;justify-content:space-between;align-items:baseline;gap:12px}
.civ h1{font-size:1.15rem;margin:0;font-weight:700}
.counts{display:flex;gap:6px;font-size:.85rem}
.counts span{display:inline-flex;align-items:center;gap:3px}
.dot{width:10px;height:10px;border-radius:50%;display:inline-block}
.track{display:flex;gap:6px;margin:8px 0}
.seg{flex:1;font-size:.72rem;color:var(--muted)}
.seg .pips{display:flex;gap:2px;margin-top:2px}
.seg .pip{flex:1;height:5px;border-radius:2px;background:var(--line)}
.seg .pip.on{background:var(--ink)}
.seg.cur{color:var(--ink);font-weight:700}
nav.tabs{display:flex;gap:4px}
nav.tabs button{flex:1;background:none;border:0;border-bottom:3px solid transparent;padding:8px 2px;font:inherit;font-size:.92rem;color:var(--muted);cursor:pointer;white-space:nowrap}
.pharea{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;align-items:flex-start;padding:14px;border:1.5px dashed var(--line);border-radius:12px;min-height:110px;margin:8px 0 10px}
.pharea .note.big2 .p{font-size:clamp(1.8rem,8vw,2.6rem)}
.pick{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.wisp{height:2.6rem;width:auto;display:block;color:var(--muted)}
.wisp.sm{height:1.1rem;display:inline-block;vertical-align:-3px;color:inherit}
.pause{display:flex;align-items:center;justify-content:center;align-self:stretch;background:none;border:0;border-radius:8px;padding:0 6px;margin:0 8px;cursor:grab;touch-action:none;-webkit-user-select:none;user-select:none;color:var(--muted)}
.pause[aria-pressed="true"]{outline:3px solid var(--s);outline-offset:2px}
.brk{flex-basis:100%;height:0}
.phw.tokp{background:transparent;color:var(--muted);border:1.5px dashed var(--line);padding:4px 8px}
.pk{display:flex;flex-direction:column;align-items:flex-start;font:inherit;background:var(--note);color:var(--note-ink);border:0;border-radius:2px 2px 8px 2px;padding:4px 10px;cursor:pointer;box-shadow:0 1px 0 rgba(0,0,0,.15)}
.pk:active{transform:scale(.95)}
.pk:focus-visible{outline:3px solid var(--s);outline-offset:2px}
.pk .p{font-family:"Gaegu","Segoe Print",cursive;font-weight:700;font-size:1.25rem;line-height:1.1}
.pk .m{font-size:.72rem;opacity:.8}
.pk.sup{background:#BCDFEE;color:#14262E;outline:1.5px dashed #2E5E73;outline-offset:-3px}
nav.tabs button[aria-current="true"]{color:var(--ink);border-bottom-color:var(--ink);font-weight:700}
main{max-width:720px;margin:0 auto;padding:18px 16px 60px}
h2{font-size:1.35rem;margin:0 0 6px}
h3{font-size:1.05rem;margin:22px 0 6px}
p{margin:0 0 12px}
.muted{color:var(--muted)}
.small{font-size:.88rem}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:14px;margin:12px 0}
label{display:block;font-weight:700;font-size:.92rem;margin:10px 0 4px}
input[type=text],textarea{width:100%;font:inherit;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)}
textarea{min-height:90px}
input:focus-visible,button:focus-visible,textarea:focus-visible{outline:3px solid var(--s);outline-offset:2px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.row>input{flex:1;min-width:0}
button.b{font:inherit;font-weight:700;padding:10px 16px;border-radius:8px;border:1.5px solid var(--btn);background:var(--btn);color:var(--btn-ink);cursor:pointer}
button.g{font:inherit;padding:9px 14px;border-radius:8px;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
button:disabled{opacity:.4;cursor:not-allowed}
button.wide{width:100%;margin-top:10px;display:block;clear:both}
.slipbtn{display:block;width:100%;padding:0;border:0;background:none;text-align:left;cursor:pointer;font:inherit;color:inherit;border-radius:4px}
.slipbtn:active .note{transform:scale(.96)}
.slipbtn:focus-visible{outline:3px solid var(--s);outline-offset:2px}
.phbar{position:sticky;bottom:calc(env(safe-area-inset-bottom,0px) + 8px);z-index:4;margin-top:18px;background:var(--surface);border:1.5px solid var(--ink);border-radius:12px;padding:10px;box-shadow:0 10px 24px -12px rgba(0,0,0,.45)}
.phwords{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px}
.guess{position:sticky;top:calc(var(--hdrh,112px) + 6px);z-index:4;display:flex;align-items:center;gap:8px;flex-wrap:wrap;background:var(--surface);border:1.5px solid var(--ink);border-radius:12px;padding:8px 12px;margin:0 0 12px;box-shadow:0 8px 18px -12px rgba(0,0,0,.45)}
.gw{font-family:"Gaegu","Segoe Print",cursive;font-size:1.5rem;font-weight:700;line-height:1.2;background:var(--note);color:var(--note-ink);padding:2px 10px;border-radius:2px 2px 8px 2px}
.gw.sup{background:#BCDFEE;color:#14262E;outline:1.5px dashed #2E5E73;outline-offset:-3px}
.gq{font-weight:700;font-size:1.2rem}
.phguess{position:absolute;top:calc(env(safe-area-inset-top,0px) + 12px);left:14px;right:66px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.phw{flex:none;font-family:"Gaegu","Segoe Print",cursive;font-size:1.3rem;font-weight:700;background:var(--note);color:var(--note-ink);border:0;border-radius:2px 2px 8px 2px;padding:4px 10px;cursor:pointer}
.phw.sup{background:#BCDFEE;color:#14262E;outline:1.5px dashed #2E5E73;outline-offset:-3px}
.phfs{position:fixed;inset:0;z-index:30;background:var(--bg);display:flex;align-items:center;justify-content:center;padding:calc(env(safe-area-inset-top,0px) + 64px) 16px calc(env(safe-area-inset-bottom,0px) + 80px);overflow:auto}
.phfs-words{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;align-items:flex-start;max-width:1000px;margin:auto}
.note.big2{padding:14px 18px;min-width:5ch;text-align:center}
.note.big2 .p{font-size:clamp(2.2rem,10vw,3.6rem)}
.note.big2 .m{font-size:1rem}
.phctl{position:fixed;bottom:calc(env(safe-area-inset-bottom,0px) + 12px);left:50%;transform:translateX(-50%);display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:center;width:calc(100% - 24px);max-width:520px}
.phctl .hint{flex-basis:100%;text-align:center}
button.note{border:0;font:inherit;cursor:grab;touch-action:none;-webkit-user-select:none;user-select:none}
.note[aria-pressed="true"],.phw[aria-pressed="true"]{outline:3px solid var(--s);outline-offset:3px}
.phw[aria-pressed="true"]{outline-offset:1px}
.phsel{margin-bottom:8px}
.yn{display:flex;gap:10px;justify-content:center;flex-basis:100%;margin-bottom:8px}
.ynw{display:flex;flex-direction:column;align-items:center;font:inherit;background:var(--note);color:var(--note-ink);border:0;border-radius:2px 2px 10px 2px;padding:6px 16px;min-width:88px;box-shadow:0 1px 0 rgba(0,0,0,.18),0 6px 14px -8px rgba(0,0,0,.35)}
button.ynw{cursor:pointer}
.ynw .p{font-family:"Gaegu","Segoe Print",cursive;font-weight:700;font-size:1.5rem;line-height:1.1}
.ynw .m{font-size:.75rem;opacity:.8}
.yn.big .ynw .p{font-size:2.4rem}
.yn.big .ynw .m{font-size:.9rem}
.spot.sm{width:58px}
.spot.center{float:none;display:block;margin:0 auto 6px;width:72px}
.panel,.grid,.tokens,.check{clear:both}
.err{color:var(--bad);font-weight:700;margin:8px 0}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{font:inherit;font-size:.9rem;padding:6px 12px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
.chip[aria-pressed="true"]{border-color:currentColor;font-weight:700;background:var(--bg)}
/* sticky notes */
.note{background:var(--note);color:var(--note-ink);border-radius:2px 2px 10px 2px;padding:8px 12px 10px;box-shadow:0 1px 0 rgba(0,0,0,.18),0 6px 14px -8px rgba(0,0,0,.35);display:flex;flex-direction:column;min-width:0}
.note .p{font-family:"Gaegu","Segoe Print",cursive;font-size:1.6rem;line-height:1.05;font-weight:700;word-break:break-word}
.note .m{font-size:.85rem;border-top:1px dashed rgba(0,0,0,.25);margin-top:4px;padding-top:3px}
.note .m.q{color:var(--note-q);font-weight:700}
.note .k{font-size:.7rem;opacity:.7}
.note.sup{background:#BCDFEE;color:#14262E;outline:2px dashed #2E5E73;outline-offset:-5px}
.note.sup .m.q{color:#3B6A7E}
.note.sup .k{font-weight:700;opacity:1}
.note.big{clear:both;transform:rotate(-1.5deg);padding:18px 22px;margin:18px auto;max-width:340px;text-align:center}
.note.big .p{font-size:3rem}
.note.big .m{font-size:1.1rem}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px}
.letter{margin:18px 0 8px}
.tab{display:inline-flex;align-items:center;gap:10px;background:#2A2620;color:#EDE6D6;height:36px;padding:0 3px 0 12px;border-radius:6px 999px 999px 6px;border:1px solid var(--line)}
.tab::before{content:"";width:30px;height:1.5px;background:#EDE6D6;opacity:.55;box-shadow:0 -6px 0 0 rgba(237,230,214,.25)}
.badge{width:30px;height:30px;border-radius:50%;border:1.5px solid #EDE6D6;display:grid;place-items:center;font-family:"Gaegu",cursive;font-weight:700;font-size:1.15rem;line-height:1}
.tokens{display:flex;gap:10px;justify-content:center;margin:10px 0}
.tok{width:26px;height:32px;display:inline-block}
.tok svg{width:100%;height:100%;overflow:visible}
.tok .tb{fill:none;stroke:var(--muted);stroke-width:1.4;stroke-dasharray:3 2.5}
.tok .tl{fill:none;stroke:var(--muted);stroke-width:1}
.tok.on .tb{fill:#2A2620;stroke:var(--ink);stroke-dasharray:none}
.tok.on .tl{stroke:#EDE6D6}
.hero{display:block;width:100%;height:auto;margin:0 0 18px}
.spot{float:right;width:76px;height:auto;margin:0 0 6px 12px;overflow:visible}
.spot-mo{width:64px}
.rules h3{clear:both}
.rules-hello{display:flex;align-items:center;gap:12px;margin:4px 0 14px;padding:12px;border-radius:12px;background:linear-gradient(135deg,rgba(242,184,59,.22),rgba(155,107,200,.18) 55%,rgba(63,167,160,.2))}
.rules-hello .spot{float:none;margin:0;flex:none}
.rules-hello p{margin:0 0 8px}
.mark{display:inline-block;width:18px;height:18px;margin-right:8px;vertical-align:-3px;border-radius:50%;border:1.5px solid currentColor;background:radial-gradient(circle,currentColor 0 2.5px,transparent 3px)}
main h2::after{content:"";display:block;width:64px;height:10px;margin-top:6px;opacity:.6;background:radial-gradient(circle at 5px 5px,var(--muted) 0 2.2px,transparent 2.7px),linear-gradient(var(--muted),var(--muted)) 14px 4.5px/50px 1px no-repeat}
.knowledge{display:flex;flex-direction:column;gap:6px}
.knowledge button{text-align:left;font:inherit;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);cursor:pointer;display:flex;justify-content:space-between;gap:8px}
.knowledge button[aria-pressed="true"]{border-color:var(--ink);border-width:2.5px;font-weight:700}
.knowledge .kitem{display:flex;justify-content:space-between;gap:8px;padding:10px 12px;border:1.5px solid var(--line);border-radius:8px;background:var(--bg)}
.knowledge .kitem.sel{border-color:var(--ink);border-width:2.5px;font-weight:700}
.knowledge .ic{display:flex;gap:3px;align-items:center}
.banner{border-left:4px solid var(--m);padding:8px 12px;background:var(--surface);margin:10px 0;font-weight:700}
.cave-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
.cave-grid button{padding:0 0 4px;border:2px solid var(--line);border-radius:8px;background:var(--bg);cursor:pointer;overflow:hidden;color:var(--ink);font:inherit;font-size:.8rem}
.cave-grid img,.cave-list img,.cave img{width:100%;display:block;border-radius:6px}
.cave-list{display:flex;flex-direction:column;gap:8px;margin-top:8px}
.cave{position:relative;cursor:crosshair;margin:8px 0}
.pin{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border:4px solid #E0302A;border-radius:50%;box-shadow:0 0 0 3px rgba(255,255,255,.85);pointer-events:none}
.cave-list button{padding:0;border:0;background:none;cursor:zoom-in;display:block;width:100%}
.cave-nav{display:flex;align-items:center;justify-content:space-between;gap:8px;margin:4px 0 8px}
.fs{position:fixed;inset:0;z-index:30;overflow:hidden;background:#000;color:#fff;display:flex;align-items:center;justify-content:center;touch-action:pan-y pinch-zoom}
.fs-stage{position:relative;max-width:100vw;flex:none}
.fs-stage img{width:100%;height:100%;display:block}
.fs-stage[data-a]{cursor:crosshair}
.fs-ov{position:absolute;z-index:2;display:flex;align-items:center;justify-content:center;font:inherit;font-weight:700;color:#fff;background:rgba(0,0,0,.45);border:1px solid rgba(255,255,255,.55);border-radius:999px;cursor:pointer;min-width:44px;min-height:44px;-webkit-backdrop-filter:blur(4px);backdrop-filter:blur(4px)}
.fs-ov:focus-visible{outline:3px solid #fff;outline-offset:2px}
.fs-x{top:calc(env(safe-area-inset-top,0px) + 10px);right:calc(env(safe-area-inset-right,0px) + 10px);font-size:1.2rem}
.fs-rot{top:calc(env(safe-area-inset-top,0px) + 10px);left:calc(env(safe-area-inset-left,0px) + 10px);font-size:1.2rem}
.fs-prev,.fs-next{top:50%;transform:translateY(-50%);font-size:1.6rem;line-height:1;padding-bottom:3px}
.fs-prev{left:calc(env(safe-area-inset-left,0px) + 8px)}
.fs-next{right:calc(env(safe-area-inset-right,0px) + 8px)}
.fs-cap{bottom:calc(env(safe-area-inset-bottom,0px) + 10px);left:50%;transform:translateX(-50%);font-weight:400;font-size:.85rem;padding:4px 12px;min-height:32px;cursor:default;white-space:nowrap;pointer-events:none}
.overlay{position:fixed;inset:0;background:rgba(10,14,24,.55);display:flex;align-items:flex-end;justify-content:center;z-index:20;padding:12px}
.sheet{background:var(--surface);color:var(--ink);border-radius:14px;padding:18px;width:100%;max-width:560px;max-height:85vh;overflow:auto;margin-bottom:env(safe-area-inset-bottom,0px)}
.timer{font-variant-numeric:tabular-nums;font-weight:700;text-align:center;font-size:1.3rem}
.timer.out{color:var(--bad)}
.score{font-size:2.6rem;font-weight:700;text-align:center;margin:6px 0}
table{border-collapse:collapse;width:100%;font-size:.95rem}
td,th{padding:6px 4px;border-bottom:1px solid var(--line);text-align:left}
td.n{text-align:right;font-variant-numeric:tabular-nums}
.check{display:flex;gap:10px;flex-wrap:wrap;font-size:.9rem}
.check .ok{color:var(--ok);font-weight:700}
.rules p,.rules li{max-width:68ch}
.rules ul{padding-left:20px}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
