function keepPre(){const r=S.round;if(ui.mentorView==='card'&&r.pick&&$('kp'))r.pre={kp:val('kp'),sp:val('sp'),sm:val('sm')}}
const AUTO_MEANINGS=['Yes','No','I','Know','You','Water','Fire','Sun','Moon','Big','Small','Many','Not','Go','Eat','See','Say','Hand','Animal','Tree','Stone','Good','Bad','Up','Down','Person','Make','Give','Time','Home','Same','Want','Day','Night'];
function autofillBasic(){
  const basics=S.words.filter(w=>w.kind==='basic'),have=new Set(basics.map(w=>norm(w.meaning)));
  let left=basicN()-basics.length;if(left<1)return;
