function enlightenView(){
  const r=S.round,w=wordById(r.pronId),sup=r.supportId?wordById(r.supportId):null;
  const tokens=Array.from({length:5},(_,i)=>`<span class="tok${i<S.board?' on':''}">${TOK}</span>`).join('');
  const H=[['ancestor','Ancestor',1,'Mentor points at a drawing'],['telepathy','Telepathy',2,'Mentor reveals the support word’s meaning'],['inspiration','Inspiration',3,'Add one new word to the dictionary']];
  return`<h2>Generation ${r.gen} · Enlighten</h2>
  <div class="banner">New language only. ${gestures(r.gen)?'Gestures are allowed.':'No gestures from Generation 3 on.'}</div>
  ${isShort()&&r.gen===lastGen()&&S.played[r.gen]===need(r.gen)-1?'<div class="banner" style="border-left-color:var(--w)">Final word. Understand it and your civilization wins.</div>':''}
  ${S.timer?`<div class="timer" id="timer"></div>`:''}
  ${noteHTML(w,true)}
  <div class="tokens" role="img" aria-label="${S.board} Enlighten tokens left">${tokens}</div>
  <p class="small muted" style="text-align:center">${S.board} token${S.board===1?'':'s'} left. Mentor: ${esc(mentorName())}</p>
  ${S.board<1?'<div class="banner">No tokens left, so no one can answer. Undo a hint below if it wasn’t really used, or end the round as a failure.</div>':''}
  <button class="b wide" data-a="answer" ${S.board<1?'disabled':''}>“I know!” Answer (1 token)</button>
  ${r.guesses.length?`<p class="small" style="margin-top:10px">Wrong guesses: ${r.guesses.map(esc).join(', ')}</p>`:''}
  <h3>Spend tokens on hints</h3><p class="small muted">Everyone must agree. Each hint once per Knowledge. If you tap one by mistake, undo it to get the tokens back.</p>
  ${H.map(([k,l,c,d])=>{const dis=r.hints[k]||S.board<c||(k==='telepathy'&&!sup);const why=r.hints[k]?'already used':(k==='telepathy'&&!sup)?'needs a supporting word':S.board<c?`needs ${c} tokens`:S.board===c?'uses your last tokens':'';return`<button class="g wide" data-a="hint" data-v="${k}" ${dis?'disabled':''}><strong>${l}</strong> (${c} token${c>1?'s':''}) · ${d}${why?`<br><span class="small">${why}</span>`:''}</button>`}).join('')}
  ${Object.keys(r.hints).some(k=>r.hints[k])?`<div class="panel"><p class="small" style="margin:0 0 6px"><strong>Hints used this round</strong></p>${H.filter(([k])=>r.hints[k]).map(([k,l,c])=>`<div class="row" style="justify-content:space-between;margin:4px 0"><span>${l} (${c} token${c>1?'s':''})</span><button class="g" data-a="undoHint" data-v="${k}">Undo</button></div>`).join('')}</div>`:''}
